# Use newly rotated credentials. Never copy values from Git history.
SUPABASE_URL=
SUPABASE_KEY=
CRYCON_ADMIN_API_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
WEB3BIO_API_KEY=

# Discovery supports exactly github and discourse.
KEYWORDS=Solana validator|governance delegate|DAO governance|DeFi governance|staking validator
SOURCES=github,discourse
DISCOURSE_FORUMS=https://gov.uniswap.org,https://forum.arbitrum.foundation,https://governance.aave.com,https://forum.makerdao.com,https://research.lido.fi,https://discuss.ens.domains
MAX_RESULTS=50
MAX_PER_KEYWORD_PER_SOURCE=10
SLEEP_MIN=1
SLEEP_MAX=2
ENRICH_LIMIT=30
WALLET_DEEP_LIMIT=20
# Empty uses historical per-command defaults: enrichment=3, deep scan=15.
MAX_GITHUB_REPOS_TO_SCAN=
MAX_DISCOURSE_SEARCHES_PER_USER=6
